{
  "name": "@nish1896/mui-components-root",
  "version": "2.1.0",
  "description": "A suite of 25+ production-ready, form-library-agnostic Material UI components — build forms with any form library, or drop in each one standalone. Fully typed, tree-shakable, and optimized for enterprise-grade forms.",
  "author": "Nishant Kohli",
  "private": true,
  "homepage": "https://mui-components-docs.vercel.app/",
  "repository": {
    "url": "git+https://github.com/nishkohli96/mui-components.git"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "scripts": {
    "lib": "pnpm -F @nish1896/mui-components run lib:build",
    "lib:lint": "pnpm -F @nish1896/mui-components run lint",
    "lib:pack": "sh scripts/pack-pkg.sh",
    "doc": "pnpm -F @nish1896/mui-components-docs run dev",
    "docs:lint": "pnpm -F @nish1896/mui-components-docs run lint",
    "docs:build": "pnpm -F @nish1896/mui-components-docs run build",
    "docs:prod": "pnpm -F @nish1896/mui-components-docs run prod"
  },
  "devDependencies": {
    "turbo": "2.10.0"
  },
  "keywords": [
    "material-ui",
    "mui",
    "mui-v9",
    "mui-v8",
    "@mui/material",
    "@mui/icons-material",
    "@mui/material-nextjs",
    "react",
    "typescript",
    "component-library",
    "form-components",
    "form-library-agnostic",
    "controlled-components",
    "react-hook-form",
    "tanstack-form",
    "formik",
    "form-validation",
    "react-forms",
    "mui-components",
    "autocomplete",
    "date-picker",
    "file-upload",
    "tags-input",
    "tree-shakable",
    "react-file-uploader"
  ],
  "packageManager": "pnpm@11.20.0",
  "license": "MIT"
}
