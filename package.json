{
  "name": "@nish1896/mui-components-root",
  "version": "1.0.0",
  "description": "A suite of 25+ production-ready react-hook-form components built with material-ui. Fully typed, tree-shakable, and optimized for enterprise-grade forms.",
  "author": "Nishant Kohli",
  "private": true,
  "homepage": "https://github.com/nishkohli96/mui-components-components#readme",
  "repository": {
    "url": "git+https://github.com/nishkohli96/mui-components-components.git"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "scripts": {
    "lib": "pnpm -F @nish1896/mui-components run lib:build",
    "lib:lint": "pnpm -F @nish1896/mui-components run lint",
    "lib:pack": "sh pack-pkg.sh",
    "doc": "pnpm -F @nish1896/mui-components-docs run start",
    "docs:lint": "pnpm -F @nish1896/mui-components-docs run lint",
    "docs:build": "pnpm -F @nish1896/mui-components-docs run build",
    "docs:prod": "pnpm -F @nish1896/mui-components-docs run prod"
  },
  "devDependencies": {
    "turbo": "2.10.0"
  },
  "keywords": [
    "react-hook-form",
    "mui",
    "material-ui",
    "mui-v7",
    "mui-v6",
    "mui-v5",
    "react forms",
    "form validation",
    "form components",
    "typescript",
    "component library",
    "react ui",
    "mui components",
    "react form library",
    "rhf",
    "react hook form material ui"
  ],
  "packageManager": "pnpm@11.10.0",
  "license": "MIT"
}
