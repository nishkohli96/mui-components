{
  "name": "@nish1896/mui-components",
  "version": "2.2.0",
  "description": "A suite of 25+ production-ready, form-library-agnostic Material UI components — build forms with any form library, or drop in each one standalone. Fully typed, tree-shakable, and optimized for enterprise-grade forms.",
  "author": "Nishant Kohli",
  "homepage": "https://mui-components-docs.vercel.app",
  "repository": {
    "url": "git+https://github.com/nishkohli96/mui-components.git"
  },
  "license": "MIT",
  "scripts": {
    "lib:build": "tsdown && node scripts/prepare-package-json.mjs && cp README.md dist/ && cp .npmignore dist/",
    "lint": "eslint --fix ."
  },
  "type": "module",
  "sideEffects": false,
  "devDependencies": {
    "@ckeditor/ckeditor5-core": "43.3.0",
    "@ckeditor/ckeditor5-react": "9.0.0",
    "@ckeditor/ckeditor5-utils": "43.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.1",
    "@nish1896/eslint-flat-config": "^3.1.6",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ckeditor5": "43.3.0",
    "eslint": "^9.39.4",
    "react": "^19.2.8",
    "react-color-palette": "7.3.1",
    "react-dom": "^19.2.8",
    "react-international-phone": "^4.8.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@mui/system": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-link": {
      "optional": true
    },
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/extension-text-align": {
      "optional": true
    },
    "@tiptap/extension-underline": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    }
  },
  "exports": {
    "./package.json": "./dist/package.json",
    ".": "./dist/index.js",
    "./config": "./dist/config/index.js",
    "./form-helpers": "./dist/form-helpers/index.js",
    "./mui": "./dist/mui/index.js",
    "./mui/*": "./dist/mui/*/index.js",
    "./mui-pickers": "./dist/mui-pickers/index.js",
    "./mui-pickers/*": "./dist/mui-pickers/*/index.js",
    "./misc": "./dist/misc/index.js",
    "./misc/*": "./dist/misc/*/index.js",
    "./types": "./dist/types/index.js",
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "types": "./index.d.ts",
  "keywords": [
    "material-ui",
    "mui",
    "mui-v9",
    "mui-v8",
    "@mui/material",
    "@mui/icons-material",
    "@mui/material-nextjs",
    "react",
    "typescript",
    "component-library",
    "form-components",
    "form-library-agnostic",
    "controlled-components",
    "react-hook-form",
    "tanstack-form",
    "formik",
    "form-validation",
    "react-forms",
    "mui-components",
    "autocomplete",
    "date-picker",
    "file-upload",
    "tags-input",
    "tree-shakable",
    "react-file-uploader"
  ]
